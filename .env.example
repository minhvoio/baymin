# Provider: ollama | openai | anthropic
LLM_PROVIDER=ollama

# Model name per provider:
#   ollama:    gpt-oss:latest, llama3.1:70b, qwen3:32b, etc.
#   openai:    gpt-4o, gpt-4o-mini, etc.
#   anthropic: claude-sonnet-4-20250514, claude-3-5-haiku-20241022, etc.
LLM_MODEL=gpt-oss:latest
LLM_MODEL_QUIZ=llama3.1:70b

# Ollama settings (only needed when LLM_PROVIDER=ollama)
OLLAMA_URL=http://localhost:11434/

# API keys (only needed for the provider you choose)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
